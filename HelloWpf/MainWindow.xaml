<Window x:Class="HelloWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HelloWpf.ViewModels"
        Title="问候程序" Width="420" Height="280"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <StackPanel Margin="24">
        <TextBlock Text="请输入你的名字" FontSize="18" Margin="0,0,0,12" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="16" Padding="8" Margin="0,0,0,12" />
        <Button Content="打个招呼" Command="{Binding GreetCommand}"
                Padding="12,8" HorizontalAlignment="Left" IsDefault="True" />
        <TextBlock Text="{Binding Greeting}" FontSize="20"
                   Margin="0,20,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
